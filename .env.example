# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# MySQL 连接字符串格式:
# mysql://用户名:密码@主机地址:端口/数据库名
# 
# 例如你的本地 MySQL:
# 用户名是 root
# 密码是 123456 (这里请替换成你实际设置的密码)
# 数据库名叫 cs_growth_platform
DATABASE_URL="mysql://prisma_user:19970127Abcd@localhost:3306/cs_growth_platform"

# ==========================================
# CORS 跨域配置（仅后端使用）
# ==========================================
# 允许访问本 API 的前端来源列表，多个逗号分隔。
# 生产环境必须明确配置，避免使用 *。
# 示例：
#   CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
# 本地开发可设：
  CORS_ORIGINS="http://39.96.44.9,http://localhost:5173,http://127.0.0.1:5173"
# 不设置或设为 * 时默认放行所有来源（不推荐用于生产环境）
# CORS_ORIGINS="*"

# API 服务端口（可选，默认 3001）
# PORT=3001
