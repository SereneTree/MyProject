# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# MySQL 连接字符串格式:
# mysql://用户名:密码@主机地址:端口/数据库名
#
# ⚠️ 安全要求：
#   1. 不要使用 root 帐号跑应用，必须使用业务专用账号 prisma_user
#   2. 本文件仅作示例模板，会提交到 git。下面的密码、主机、库名均为占位符，
#      真实凭据请只写在本地未提交的 .env 中
#   3. 产生环境密码请使用 24+ 位强密码（混合大小写字母/数字/符号）并定期轮换
DATABASE_URL="mysql://prisma_user:<YOUR_STRONG_PASSWORD>@localhost:3306/cs_growth_platform"

# ==========================================
# CORS 跨域配置（仅后端使用）
# ==========================================
# 允许访问本 API 的前端来源列表，多个逗号分隔。
# 生产环境必须明确配置，避免使用 *。
# 示例：
#   CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"
# 本地开发可设：
  CORS_ORIGINS="http://www.neowhale.cn,http://neowhale.cn,https://www.neowhale.cn,https://neowhale.cn,http://39.96.44.9,http://localhost:5173,http://127.0.0.1:5173"
# 不设置或设为 * 时默认放行所有来源（不推荐用于生产环境）
# CORS_ORIGINS="*"

# 可选：用正则补充白名单（逗号分隔，不区分大小写）。
# 代码中已内置：*.neowhale.cn / localhost / 127.0.0.1，下面是补充示例。
# CORS_ORIGIN_PATTERNS="^https?://([a-z0-9-]+\.)*your-other-domain\.com$"

# API 服务端口（可选，默认 3001）
# PORT=3001

# ==========================================
# 管理员凭据（只用于 POST /api/admin/* 管理接口）
# ==========================================
# 设置后请求需携带 Header：X-Admin-Token: <同下面的值>
# 生产环境必须设置为随机长字符串，例如：
#   openssl rand -hex 32
# 不设置时所有管理接口返回 503，起默认禁用效果。
# ADMIN_TOKEN="请生成一个随机长字符串填在这里"
